# 首次启动可直接跳过本文件 — 终端里跑 python run.py 时向导会自动生成 .env。
# 非交互场景(systemd/docker 无终端)请复制为 server/.env 并填好 DATABASE_URL/JWT_SECRET。

# MySQL 连接串（docker-compose 启动的默认账号如下; 也可用 sqlite:///./nattunnel.db 起步）
DATABASE_URL=mysql+pymysql://nattunnel:nattunnel@127.0.0.1:3306/nattunnel?charset=utf8mb4

# Redis 连接串（没有 Redis 可留空, 在线状态/登录限流自动降级为内存）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 密钥：留空则首次启动自动生成并持久化到 app_settings 表
JWT_SECRET=

# JWT 有效期（天）
JWT_EXPIRE_DAYS=7

# 初始管理员 — 仅**非交互**场景(systemd/docker 等无终端)使用:
#   交互式终端里直接 `python run.py` 首启时, 控制台会引导输入用户名/密码(优先于本段配置)。
INITIAL_ADMIN_USERNAME=admin
# 留空 => 生成随机强口令并在启动日志中一次性打印, 登录后请立即 POST /api/password 修改
INITIAL_ADMIN_PASSWORD=

# uvicorn 监听（默认只绑回环: nginx 反代走 127.0.0.1; 混部服务器勿改成 0.0.0.0）
HOST=127.0.0.1
PORT=8000
