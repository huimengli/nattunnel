# 复制为 server/.env 后按实际环境修改

# MySQL 连接串（docker-compose 启动的默认账号如下）
DATABASE_URL=mysql+pymysql://nattunnel:nattunnel@127.0.0.1:3306/nattunnel?charset=utf8mb4

# Redis 连接串
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 密钥：留空则首次启动自动生成并持久化到 app_settings 表
JWT_SECRET=

# JWT 有效期（天）
JWT_EXPIRE_DAYS=7

# 初始管理员(仅当 users 表中还没有 admin 时, 于首次启动创建)
# 用户名不合法(需 2-32 位字母数字下划线)会回退为 admin
INITIAL_ADMIN_USERNAME=admin
# 留空 => 生成随机强口令并在启动日志中一次性打印, 登录后请立即 POST /api/password 修改
# 生产环境建议在此显式设置(本文件已被 .gitignore 忽略, 不会入库)
INITIAL_ADMIN_PASSWORD=

# uvicorn 监听
HOST=0.0.0.0
PORT=8000
